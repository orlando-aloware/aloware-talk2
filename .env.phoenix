APP_NAME="Aloware Talk"
APP_ENV=local
APP_DEBUG=true
APP_SECURE=false
API_URL="https://app.local.alodev.org"
API_REPORTING_URL="https://reporting.alodev.org"

# Pusher Configuration
PUSHER_APP_KEY=""
PUSHER_CLUSTER=""

# GIPHY API KEYS
GIPHY_API_KEY=""

# Fullstory
FULLSTORY_ORG_ID=""

# DEV Intercom
INTERCOM_APP_ID="gkch34ef"

# AnnounceKit
AK_WIDGET_URL=""

# Sentry Error Logging
SENTRY_DSN_PUBLIC=""
SENTRY_TRACES_SAMPLE_RATE=0.01

# Sentry Source Mapping
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=aloware
SENTRY_PROJECT=talk2-web-dev
SENTRY_VERSION=`sentry-cli releases propose-version`

# Google Analytics
GA_TRACKING_ID=""

# macOS notarization API key
API_KEY_ID=""
API_KEY_ISSUER_ID=""

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=""

# Demo Company Ids (no spaces between company ids)
DEMO_COMPANY_IDS="7,47,1659"

# XMAS settings
XMAS_ENABLED=true
XMAS_BANNERS_ENABLED=true

# URLs
URL_READ_REVIEWS=https://www.g2.com/products/aloware/references/the-premier-cloud-contact-center-software-for-small-and-mid-sized-businesses

# Custom JavaScript
# Moderate Genius
HS_CUSTOM_JS_MOD_GENIUS="https://js-na1.hs-scripts.com/8446098.js"
# All others
HS_CUSTOM_JS="https://js.hs-scripts.com/8446098.js"
HS_DISABLE_TRACKER=false

# Custom Edge Location
CUSTOM_EDGE_LOCATION_COMPANY_IDS="1629,3788,2275,1697"

# Company IDs with beta features enabled
BETA_FEATURES_COMPANY_IDS="2565,7,47,1659,650,3631,3459,3264,3037,2403,2034,1615,568"
